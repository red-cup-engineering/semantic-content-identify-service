{
  "name": "@red-cup-engineering/semantic-content-identify-service",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "Addresses admitted, typed, normalized RMN envelopes with an explicit identity-settlement profile.",
  "keywords": [
    "rmn",
    "cbor",
    "rfc6920",
    "semantic-identity",
    "capability-cell"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/semantic-content-identify-service.git"
  },
  "homepage": "https://semantic-content-identity.actions.561.group/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "semantic-content-identity": "./scripts/semantic-content-identity.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/semantic-content-identity.mjs"
    }
  },
  "files": [
    "scripts/",
    "content/",
    "src/",
    "types/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify": "npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/relation-model-notation": "0.0.1",
    "@red-cup-engineering/relation-model-notation-cbor-codec": "0.0.1",
    "@red-cup-engineering/relation-model-notation-eval": "0.0.2",
    "@red-cup-engineering/relation-model-notation-json-codec": "0.0.3",
    "@red-cup-engineering/relation-model-notation-typing": "0.0.1"
  }
}
