{
  "name": "@red-cup-engineering/semantic-content-identify-service",
  "version": "0.1.8",
  "private": false,
  "type": "module",
  "description": "Returns the canonical RMN CBOR bytes and RFC 6920 ni URI for one admitted semantic value.",
  "keywords": [
    "rmn",
    "cbor",
    "rfc6920",
    "semantic-identity",
    "capability-cell"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/semantic-content-identify-service.git"
  },
  "homepage": "https://semantic-content-identity.actions.561.group/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "semantic-content-identity": "./scripts/semantic-content-identity.mjs",
    "materialize-relational-content": "./scripts/materialize-relational-content.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/semantic-content-identity.mjs"
    }
  },
  "files": [
    "scripts/",
    "content/",
    "src/",
    "types/"
  ],
  "scripts": {
    "materialize-manifest": "node ops/materialize-manifest.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lenticule-science/rmn-semantic-conformance-die": "6.0.1"
  }
}
